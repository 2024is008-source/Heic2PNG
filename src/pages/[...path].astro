---
import {getCollection, render} from 'astro:content';
import {renderDesign, prepareArticle, articlePath} from '../lib/design.mjs';
import {canonicalPageUrl} from '../lib/urls.mjs';
import {createStructuredData,serializeStructuredData} from '../lib/structured-data.mjs';
import AdSlot from '../components/AdSlot.astro';
import '../styles/generated.css';
import '../styles/approved.css';
export async function getStaticPaths() {
 const articles=(await getCollection('blog')).filter(e=>!e.data.draft);
 const paths=['','heic-to-jpg','heic-to-avif','blog','about','contact','privacy','terms'];
 return [...paths.map(path=>({params:{path:path||undefined}})),...articles.map(entry=>({params:{path:'blog/'+entry.data.slug},props:{entry}}))];
}
const articles=(await getCollection('blog')).filter(e=>!e.data.draft).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
const path=Astro.props.pathOverride||(Astro.params.path?'/'+Astro.params.path:'/');
const entry=Astro.props.entry;
const titles={
 '/':'HEIC to PNG Converter – Free Online',
 '/heic-to-jpg':'HEIC to JPG Converter – Free Online',
 '/heic-to-avif':'HEIC to AVIF Converter – Free Online',
 '/blog':'HEIC Conversion Guides – PNG, JPG & AVIF',
 '/about':'About Our HEIC Image Converters',
 '/contact':'Contact Support & Report Issues',
 '/privacy':'Privacy Policy – Image Conversion & Site Data',
 '/terms':'Terms of Service',
 '/404':'404 Page Not Found'
};
const descriptions={
 '/':'Convert HEIC to PNG with a free online converter. Add .heic files, choose image dimensions, and download PNGs individually or in a batch ZIP.',
 '/heic-to-jpg':'Convert HEIC to JPG online for free. Adjust JPEG quality and image dimensions, then download individual JPG files or a ZIP of your converted photos.',
 '/heic-to-avif':'Convert HEIC to AVIF online for free. Choose quality, chroma subsampling or lossless encoding, adjust dimensions, and download AVIF files or a ZIP.',
 '/blog':'Learn how to convert HEIC photos to PNG, JPG or AVIF. Explore Windows, Mac and iPhone tutorials, format comparisons, quality tips and upload fixes.',
 '/about':"Learn about HEIC2PNG's browser-based image converters, local photo processing, output limitations and guides for HEIC, PNG, JPG and AVIF.",
 '/contact':'Contact HEIC2PNG about conversion problems, unsupported HEIC files or guide corrections. The contact form opens your email app to prepare a message.',
 '/privacy':'Read how HEIC2PNG handles local image conversion, technical logs, cookies and possible advertising, plus how to contact us about privacy.',
 '/terms':"Read the terms for using HEIC2PNG's image converters and guides, including file responsibilities, copyright and service limitations.",
 '/404':'The requested page could not be found.'
};
const title=(entry?.data.title||titles[path])+' | HEIC2PNG';
const description=descriptions[path]||entry?.data.description;
const canonical=canonicalPageUrl(path);
const showAdAreas=import.meta.env.PUBLIC_SHOW_AD_AREAS==='true';
let {body,bodyClass}=renderDesign(path,articles);
const {Content}=entry?await render(entry):{Content:undefined};
const marker='<section id="view-blog-article"';
let before=body,after='';
if(entry) {
 const start=body.indexOf(marker); const end=body.lastIndexOf('</section>')+10;
 before=body.slice(0,start); after=body.slice(end);
}
// Keep every existing ad slot as a reusable component at the same location.
const parts=before.split(/(<div class="ad-placeholder-block[\s\S]*?<\/div>\s*<\/div>)/g);
const schema=createStructuredData({path,title,description,entry,noindex:path==='/404'});
---
<!doctype html>
<html lang="en" class="scroll-smooth">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={entry?'article':'website'} />
  <meta property="og:site_name" content="HEIC2PNG" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {entry?.data.image&&<meta property="og:image" content={new URL(entry.data.image,Astro.site).href} />}
  {path==='/404'&&<meta name="robots" content="noindex,follow" />}
  <link href="/fonts/fonts.css" rel="stylesheet" />
  {schema&&<script is:inline type="application/ld+json" set:html={serializeStructuredData(schema)} />}
 </head>
 <body class={bodyClass} data-show-ad-areas={String(showAdAreas)} data-format={path==='/heic-to-avif'?'AVIF':path==='/heic-to-jpg'?'JPG':'PNG'}>
  {parts.map((part,i)=>i%2?<AdSlot html={part}/>:<Fragment set:html={part}/>)}
  {Content&&<Content />}
  <Fragment set:html={after} />
  <script src="../scripts/client.ts"></script>
 </body>
</html>
