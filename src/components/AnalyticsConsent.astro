---
import '../styles/analytics-consent.css';
---
<section id="analytics-consent" class="analytics-consent" role="region" aria-labelledby="analytics-consent-title" hidden>
  <h2 id="analytics-consent-title" tabindex="-1">Analytics preferences</h2>
  <p>Allow Google Analytics cookies to measure visits and traffic sources? Your images and filenames stay out of analytics. All converters work if you reject.</p>
  <a href="/privacy/#analytics-preferences">Privacy details</a>
  <p id="analytics-consent-status" role="status" aria-live="polite"></p>
  <div class="analytics-consent-actions">
    <button type="button" data-analytics-consent="granted">Accept analytics</button>
    <button type="button" data-analytics-consent="denied">Reject analytics</button>
  </div>
</section>
