# Optional verified support mailbox. No invented address or fake form success.
PUBLIC_CONTACT_EMAIL=backbencherz@gmail.com
# Hide all ad areas without reserving space. Set true and rebuild to restore them.
PUBLIC_SHOW_AD_AREAS=false
# Advertising is intentionally gated off pending isolated integration and a CMP.
PUBLIC_ADSENSE_PUBLISHER_ID=
# Release gate: enable only after disabling GA4 Enhanced Measurement and reviewing
# the manual CSP proposal in GA4_IMPLEMENTATION.md. Dev/localhost stay disabled.
PUBLIC_GA4_ENABLED=false
# Optional allowlisted conversion/download events; requires consent and GA4 above.
PUBLIC_GA4_EVENTS=false
